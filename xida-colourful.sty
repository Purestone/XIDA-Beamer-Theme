\ProvidesPackage{xida-colourful}[2026/11/07 Colourful XIDA theme]
\RequirePackage{xida}
% Inspired by the red, yellow and blue on the shield.
\definecolor{ShieldRed}{HTML}{D70A2B}
\definecolor{ShieldBlue}{HTML}{174F95}
\definecolor{ShieldGold}{HTML}{F9B500}
\setbeamercolor{section in head/foot}{fg=white,bg=ShieldBlue}
\setbeamercolor{xida footer}{fg=MasterbrandBlack,bg=ShieldGold}
\setbeamercolor{frametitle}{fg=white,bg=ShieldRed}
\setbeamercolor{title}{fg=white,bg=ShieldRed}
\setbeamercolor{titlelike}{fg=white,bg=ShieldRed}
\setbeamercolor{structure}{fg=ShieldBlue}
\setbeamercolor{palette primary}{fg=white,bg=ShieldBlue}
\setbeamercolor{palette tertiary}{fg=white,bg=ShieldBlue}
\setbeamercolor{palette quaternary}{fg=white,bg=ShieldBlue}
\setbeamercolor{block title}{fg=white,bg=ShieldBlue}
\setbeamercolor{block body}{fg=MasterbrandBlack,bg=ShieldBlue!8!white}
\setbeamercolor{block title example}{fg=MasterbrandBlack,bg=ShieldGold}
\setbeamercolor{block body example}{fg=MasterbrandBlack,bg=ShieldGold!12!white}
\setbeamercolor{block title alerted}{fg=white,bg=ShieldRed}
\setbeamercolor{block body alerted}{fg=MasterbrandBlack,bg=ShieldRed!8!white}
\setbeamercolor{alerted text}{fg=ShieldRed}
